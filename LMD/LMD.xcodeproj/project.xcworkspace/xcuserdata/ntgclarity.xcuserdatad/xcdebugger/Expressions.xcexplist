<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "NetworkManager.request&lt;LMD.OrdersResponse&gt;(endpoint:body:headers:):NetworkManager.swift">
         <PersistentStrings>
            <PersistentString
               value = "KeychainHelper.shared.read(service: serviceName, account: &quot;accessToken&quot;)">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "LoginViewModel.login():LoginViewModel.swift">
         <PersistentStrings>
            <PersistentString
               value = "data.accessToken">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
